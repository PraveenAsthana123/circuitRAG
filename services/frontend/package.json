{
  "name": "documind-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3000",
    "build": "NEXT_DIST_DIR=.next-prod next build",
    "start": "NEXT_DIST_DIR=.next-prod next start -p 3000",
    "lint": "next lint --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write \"{app,components,lib,utils,e2e}/**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"{app,components,lib,utils,e2e}/**/*.{ts,tsx,js,json,md,css}\"",
    "validate": "npm run lint && npm run format:check && npm run test",
    "pre-merge": "npm run validate && npm run build"
  },
  "dependencies": {
    "mermaid": "^11.14.0",
    "next": "^14.2.15",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
