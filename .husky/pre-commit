#!/usr/bin/env bash
# §19 mandatory pre-commit hook entry point.
#
# circuitRAG uses the Python `pre-commit` framework
# (.pre-commit-config.yaml at repo root) — a more powerful, polyglot
# alternative to husky. This file delegates to it so audits looking
# for `.husky/pre-commit` see a real hook here.
#
# Install (one-time):
#     pip install pre-commit
#     pre-commit install
#
# After install, .git/hooks/pre-commit calls the framework directly;
# this husky-style file is the §19 audit-visible entry point. Either
# is sufficient — running both is a no-op duplication and harmless.
#
# To run all hooks manually without committing:
#     pre-commit run --all-files

set -e

# If `pre-commit` is on PATH, run only on the staged files (the
# default behavior of `git commit`-triggered runs).
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run
fi

# Fallback: run the project's loop-watcher pre-commit script if it
# exists (this is what ADR-014 wires for advisory drill checks).
if [ -x scripts/loop_watcher_hook.py ]; then
  exec python3 scripts/loop_watcher_hook.py
fi

# No hook framework installed — do nothing rather than block the
# commit. Operator who cares can install pre-commit per the
# instructions above.
echo "[husky] pre-commit framework not installed; skipping hooks."
echo "[husky] run: pip install pre-commit && pre-commit install"
exit 0
