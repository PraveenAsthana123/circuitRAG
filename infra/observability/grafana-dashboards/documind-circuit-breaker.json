{
  "title": "Documind / Circuit Breaker",
  "uid": "documind-circuit-breaker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "documind",
    "resilience",
    "circuit-breaker"
  ],
  "_generator": "scripts/generate-grafana-dashboards.py",
  "_kiali_deep_link": "Documind / Circuit Breaker",
  "panels": [
    {
      "type": "timeseries",
      "title": "Breaker state (0=closed,1=half-open,2=open)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "documind_circuit_breaker_state",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Trips/min",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(documind_circuit_breaker_failures_total[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Half-open success ratio (forward-contract)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(documind_breaker_half_open_success_ratio)",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cognitive breaker interrupts",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (signal) (rate(documind_ccb_interrupts_total[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
