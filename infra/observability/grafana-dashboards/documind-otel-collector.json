{
  "title": "Documind / OTel Collector",
  "uid": "documind-otel-collector",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "documind",
    "opentelemetry"
  ],
  "_generator": "scripts/generate-grafana-dashboards.py",
  "_kiali_deep_link": "Documind / OTel Collector",
  "panels": [
    {
      "type": "timeseries",
      "title": "Spans accepted/s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Spans refused/s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_refused_spans[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Export send errors/s",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Metric points exported/s",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_metric_points[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
